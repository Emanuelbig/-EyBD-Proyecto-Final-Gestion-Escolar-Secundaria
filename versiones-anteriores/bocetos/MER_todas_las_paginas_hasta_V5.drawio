        <mxCell id="kqalTsbmrmvnhzo7vgT1-217" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="nota" vertex="1">
          <mxGeometry height="44" width="130" x="1005" y="1803" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-218" edge="1" parent="1" source="kqalTsbmrmvnhzo7vgT1-217" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" target="kqalTsbmrmvnhzo7vgT1-211">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-219" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="observacion" vertex="1">
          <mxGeometry height="44" width="130" x="1165" y="1803" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-220" edge="1" parent="1" source="kqalTsbmrmvnhzo7vgT1-219" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" target="kqalTsbmrmvnhzo7vgT1-211">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-221" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#cccccc;whiteSpace=wrap;" value="&lt;b&gt;Especializacion:&lt;/b&gt; PERSONA guarda los datos comunes y cada subclase tiene solo sus relaciones propias.&lt;br&gt;&amp;bull; &lt;b&gt;Total:&lt;/b&gt; toda persona es al menos profesor, alumno o tutor.&lt;br&gt;&amp;bull; &lt;b&gt;Superpuesta:&lt;/b&gt; puede ser mas de uno a la vez (ej.: un profesor que es tutor de un alumno)." vertex="1">
          <mxGeometry height="120" width="480" x="220" y="360" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-222" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#cccccc;whiteSpace=wrap;" value="&lt;b&gt;DICTADO&lt;/b&gt; = el CONTIENE (MATERIA N:M CURSO) del otro modelo. Es entidad y no relacion porque se relaciona con el profesor (DICTA) y con sus clases (TIENE): una relacion no puede relacionarse con otra relacion." vertex="1">
          <mxGeometry height="95" width="380" x="1865" y="687" as="geometry" />
        </mxCell>
        <mxCell id="kqalTsbmrmvnhzo7vgT1-223" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#cccccc;whiteSpace=wrap;" value="&lt;b&gt;Entidad debil:&lt;/b&gt; EVALUACION se identifica por la clase en que se toma + su numero (ej.: evaluacion n&amp;deg; 1 de la clase del 12/05 de Matematica 3&amp;deg;A). El numero solo no alcanza: es identificador parcial." vertex="1">
          <mxGeometry height="95" width="380" x="1460" y="1840" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
