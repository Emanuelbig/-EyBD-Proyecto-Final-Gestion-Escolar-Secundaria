        <mxCell id="kqalTsbmrmvnhzo7vgT1-75" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" value="Modelo entidad-relacion - Sistema de gestion escolar (modulo docente) - EyBD 2026" vertex="1">
