        <mxCell id="kqalTsbmrmvnhzo7vgT1-76" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#cccccc;whiteSpace=wrap;" value="&lt;b&gt;Referencias:&lt;/b&gt;&lt;br&gt;Rectangulo = entidad, Rectangulo doble = entidad debil&lt;br&gt;Rombo = relacion, Rombo doble = relacion identificatoria&lt;br&gt;Triangulo ES-UN = especializacion (superclase / subclases)&lt;br&gt;Elipse = atributo, Subrayado = identificador&lt;br&gt;Subrayado punteado = discriminante de entidad debil&lt;br&gt;Elipse punteada = atributo derivado&lt;br&gt;(min;max) junto a cada entidad = participacion&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;1:N / N:M&lt;/b&gt;&lt;/font&gt; junto al rombo = cardinalidad" vertex="1">
